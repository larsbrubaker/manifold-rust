<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>ManifoldRust</RootNamespace>
    <AssemblyName>ManifoldRust</AssemblyName>
    <!-- Nothing here reflects or uses runtime marshalling - every P/Invoke is
         source generated by LibraryImport - so the assembly survives trimming
         and native AOT. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests cover NativeArrays.NarrowChecked directly: the case it guards
         against needs a mesh with more than 4 billion vertices, so it cannot be
         reached through the public API on any machine that exists. -->
    <InternalsVisibleTo Include="ManifoldRust.Tests" />
  </ItemGroup>

  <!--
    Natives are built by cargo, per platform, and staged under native-staging/
    by the release workflow (.github/workflows/release-nuget.yml) before pack.
    win-x64 is required; the others are packed when present so a local pack still
    works with only the platform at hand. A consumer on a runtime identifier the
    package does not carry sets ManifoldNative.LibraryPath, points
    MANIFOLD_RS_NATIVE at a locally built library, or copies it next to their
    application.
  -->
  <PropertyGroup>
    <PackageId>ManifoldRust</PackageId>
    <!-- Moves with ffi/Cargo.toml's version whenever the native changes - the
         binding is only useful paired with a native, so a package carrying a new
         native is a new package version - and moves on its own when the managed
         surface grows without an ABI change, which is what 0.4.0 is: new public
         API (RepairOrientation, HasSelfIntersections, the binary Boolean /
         Union / Subtract / Intersect overloads with engine, winding rule and
         progress) over the unchanged manifold-ffi 0.3.1 ABI. The handshake in
         NativeVersionCheck compares the native's major.minor only, so it is
         unaffected either way.

         0.5.0 pairs with manifold-ffi 0.3.2, which adds
         manifold_rs_rebuild_solid / _ct (bound as RebuildSolid). Purely
         additive exports keep the ffi minor - an older binding still works
         against the newer native, and a newer binding against an older native
         fails loudly with EntryPointNotFoundException rather than silently -
         so the 0.3.x handshake is unchanged. -->
    <Version>0.5.0</Version>
    <Authors>Lars Brubaker</Authors>
    <Company>Lars Brubaker</Company>
    <Copyright>Copyright 2026 Lars Brubaker</Copyright>
    <Description>Managed bindings for manifold_rs, the C ABI of the pure-Rust port of the Manifold geometry kernel. Import a triangle soup, run an n-ary boolean (union / difference / intersection) and export the result, without the crash-on-invalid-input behaviour of the C++ binding.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/larsbrubaker/manifold-rust</PackageProjectUrl>
    <RepositoryUrl>https://github.com/larsbrubaker/manifold-rust</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>manifold;geometry;csg;boolean;mesh;3d;rust</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The binding README is the package README; nuget.org requires it to be
         packed at the root of the package. -->
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The native to pack for each runtime identifier. They default to copies
         staged under the project rather than to target\release directly, because
         a cargo build can relink those files at any moment and packing a half
         written library is not something the pack step would notice. Refresh the
         staged copies from release builds before cutting a package; override a
         property to pack a native from somewhere else. -->
    <ManifoldRustNativeWin64 Condition="'$(ManifoldRustNativeWin64)' == ''">$(MSBuildProjectDirectory)\native-staging\win-x64\manifold_rs.dll</ManifoldRustNativeWin64>
    <ManifoldRustNativeLinux64 Condition="'$(ManifoldRustNativeLinux64)' == ''">$(MSBuildProjectDirectory)\native-staging\linux-x64\libmanifold_rs.so</ManifoldRustNativeLinux64>
    <ManifoldRustNativeOsxArm64 Condition="'$(ManifoldRustNativeOsxArm64)' == ''">$(MSBuildProjectDirectory)\native-staging\osx-arm64\libmanifold_rs.dylib</ManifoldRustNativeOsxArm64>
    <ManifoldRustNativeOsx64 Condition="'$(ManifoldRustNativeOsx64)' == ''">$(MSBuildProjectDirectory)\native-staging\osx-x64\libmanifold_rs.dylib</ManifoldRustNativeOsx64>

    <!-- browser-wasm is the odd one: a static archive rather than a shared library, and a
         link input rather than something the runtime probes for - see build\ManifoldRust.props.
         It is named manifold_rs.a rather than cargo's libmanifold_rs.a because mono-wasm
         derives its P/Invoke module names from the file names it links, and it has had the
         target_features surgery in .github/scripts/rewrite-wasm-target-features.py applied.
         Both are the release workflow's job; a hand-built copy that skipped either produces
         a package that fails in the consumer's link rather than here. -->
    <ManifoldRustNativeBrowserWasm Condition="'$(ManifoldRustNativeBrowserWasm)' == ''">$(MSBuildProjectDirectory)\native-staging\browser-wasm\manifold_rs.a</ManifoldRustNativeBrowserWasm>

    <!-- Set by the release workflow. A published package missing a platform it
         claims to support is a support burden that surfaces months later as a
         DllNotFoundException on someone else's machine, so a release refuses to
         pack a partial set; a developer packing locally still gets warnings. -->
    <ManifoldRustRequireAllNatives Condition="'$(ManifoldRustRequireAllNatives)' == ''">false</ManifoldRustRequireAllNatives>
  </PropertyGroup>

  <ItemGroup>
    <!-- runtimes/<rid>/native is what the runtime's own probing looks at, so a
         consumer gets the native with no configuration at all. Conditional so a
         plain build still succeeds without a native present, and so a pack on a
         developer machine produces a win-x64-only package instead of failing;
         the release workflow is what supplies them all - see EnsureNativeIsPacked
         below for which are required. -->
    <None Include="$(ManifoldRustNativeWin64)"
          Condition="Exists('$(ManifoldRustNativeWin64)')"
          Pack="true"
          PackagePath="runtimes/win-x64/native"
          Visible="false" />
    <None Include="$(ManifoldRustNativeLinux64)"
          Condition="Exists('$(ManifoldRustNativeLinux64)')"
          Pack="true"
          PackagePath="runtimes/linux-x64/native"
          Visible="false" />
    <None Include="$(ManifoldRustNativeOsxArm64)"
          Condition="Exists('$(ManifoldRustNativeOsxArm64)')"
          Pack="true"
          PackagePath="runtimes/osx-arm64/native"
          Visible="false" />
    <None Include="$(ManifoldRustNativeOsx64)"
          Condition="Exists('$(ManifoldRustNativeOsx64)')"
          Pack="true"
          PackagePath="runtimes/osx-x64/native"
          Visible="false" />

    <!-- Same runtimes/<rid>/native layout as the rest, for consistency and so the release
         workflow's staged-versus-packed check covers it, but nothing probes it: a wasm
         archive is only ever a link input, which is what build\ManifoldRust.props makes it. -->
    <None Include="$(ManifoldRustNativeBrowserWasm)"
          Condition="Exists('$(ManifoldRustNativeBrowserWasm)')"
          Pack="true"
          PackagePath="runtimes/browser-wasm/native"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same file in both folders, because NuGet treats them differently and this
         package needs both. build/ is imported only into a project that references the
         package directly; buildTransitive/ is imported into projects that reach it through
         another reference too. The consumer that matters is exactly that second shape - an
         application whose wasm module has to carry the archive, referencing a library that
         references this package - and for it a build/-only props is never imported at all:
         no NativeFileReference, no link, no error, and a browser app that throws at its
         first CSG call.

         Both folders sit at the same depth under the package root, so the archive path the
         props computes relative to itself is the same either way.

         Packed unconditionally - the file does nothing at all off browser-wasm - so that a
         package built on a machine without the wasm leg still behaves exactly like a
         released one for every desktop consumer. -->
    <None Include="build\ManifoldRust.props"
          Pack="true"
          PackagePath="build"
          Visible="false" />
    <None Include="build\ManifoldRust.props"
          Pack="true"
          PackagePath="buildTransitive"
          Visible="false" />
  </ItemGroup>

  <!-- Publishing a package without its native is silent and useless: consumers
       only find out at the first P/Invoke. win-x64 is fatal unconditionally,
       because it is the one platform this project is always built on, so its
       absence means the staging step went wrong rather than that the platform
       was not built. The rest are fatal only under ManifoldRustRequireAllNatives
       - a local pack is a legitimate reason to be missing them.

       This target only knows about the runtime identifiers spelled out
       above. Adding a build for another means adding it here too, which the
       release workflow enforces by refusing to stage a runtime identifier this
       file does not mention. -->
  <Target Name="EnsureNativeIsPacked" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(ManifoldRustNativeWin64)')"
           Text="The win-x64 native is missing, so the package would ship without runtimes/win-x64/native/manifold_rs.dll. Build manifold_rs in release and copy target\release\manifold_rs.dll to '$(ManifoldRustNativeWin64)', or set the ManifoldRustNativeWin64 property to an existing native." />

    <!-- ErrorAndContinue so a release that is missing two platforms says so in
         one run; a plain Error would abort the target after the first. -->
    <Error Condition="'$(ManifoldRustRequireAllNatives)' == 'true' AND !Exists('$(ManifoldRustNativeLinux64)')"
           ContinueOnError="ErrorAndContinue"
           Text="The linux-x64 native is missing and ManifoldRustRequireAllNatives is set, so this release would ship without runtimes/linux-x64/native/libmanifold_rs.so. Expected at '$(ManifoldRustNativeLinux64)'." />
    <Error Condition="'$(ManifoldRustRequireAllNatives)' == 'true' AND !Exists('$(ManifoldRustNativeOsxArm64)')"
           ContinueOnError="ErrorAndContinue"
           Text="The osx-arm64 native is missing and ManifoldRustRequireAllNatives is set, so this release would ship without runtimes/osx-arm64/native/libmanifold_rs.dylib. Expected at '$(ManifoldRustNativeOsxArm64)'." />
    <Error Condition="'$(ManifoldRustRequireAllNatives)' == 'true' AND !Exists('$(ManifoldRustNativeOsx64)')"
           ContinueOnError="ErrorAndContinue"
           Text="The osx-x64 native is missing and ManifoldRustRequireAllNatives is set, so this release would ship without runtimes/osx-x64/native/libmanifold_rs.dylib. Expected at '$(ManifoldRustNativeOsx64)'." />
    <!-- Missing this one is worse than a DllNotFoundException at the first call: without
         the archive the wasm link has nothing behind manifold_rs, and build\ManifoldRust.props
         then points a NativeFileReference at a file the package does not carry, so every
         browser consumer fails at build. -->
    <Error Condition="'$(ManifoldRustRequireAllNatives)' == 'true' AND !Exists('$(ManifoldRustNativeBrowserWasm)')"
           ContinueOnError="ErrorAndContinue"
           Text="The browser-wasm native is missing and ManifoldRustRequireAllNatives is set, so this release would ship without runtimes/browser-wasm/native/manifold_rs.a. Expected at '$(ManifoldRustNativeBrowserWasm)'." />

    <Warning Condition="'$(ManifoldRustRequireAllNatives)' != 'true' AND !Exists('$(ManifoldRustNativeLinux64)')"
             Text="The linux-x64 native is missing; the package will not carry runtimes/linux-x64/native/libmanifold_rs.so. Expected at '$(ManifoldRustNativeLinux64)'." />
    <Warning Condition="'$(ManifoldRustRequireAllNatives)' != 'true' AND !Exists('$(ManifoldRustNativeOsxArm64)')"
             Text="The osx-arm64 native is missing; the package will not carry runtimes/osx-arm64/native/libmanifold_rs.dylib. Expected at '$(ManifoldRustNativeOsxArm64)'." />
    <Warning Condition="'$(ManifoldRustRequireAllNatives)' != 'true' AND !Exists('$(ManifoldRustNativeOsx64)')"
             Text="The osx-x64 native is missing; the package will not carry runtimes/osx-x64/native/libmanifold_rs.dylib. Expected at '$(ManifoldRustNativeOsx64)'." />
    <Warning Condition="'$(ManifoldRustRequireAllNatives)' != 'true' AND !Exists('$(ManifoldRustNativeBrowserWasm)')"
             Text="The browser-wasm native is missing; the package will not carry runtimes/browser-wasm/native/manifold_rs.a, and a browser consumer will have to set ManifoldRustLinkBrowserWasm=false. Expected at '$(ManifoldRustNativeBrowserWasm)'." />
  </Target>

</Project>
